[Unit]
Description=GlassOS Hub (glasses desktop control plane)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HUB_DIR__
Environment=PORT=__PORT__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON__ __HUB_DIR__/server.py --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
